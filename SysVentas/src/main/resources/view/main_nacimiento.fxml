<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="miContenedor" stylesheets="@../css/nacimiento.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.sysventas.controller.NacimientoController">
   <children>
      <VBox spacing="10.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0">
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
         <children>
            <Label styleClass="titulo-pantalla" text="Padrón de Nacimientos" />

            <!-- Panel de filtros -->
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="panel">
               <children>
                  <Label styleClass="etiqueta-filtro" text="Buscar:" />
                  <TextField fx:id="txtFiltroDato" prefWidth="180.0" promptText="Nombre, padre, madre u hospital" />
                  <Label text="Desde" />
                  <DatePicker fx:id="dpDesde" prefWidth="130.0" />
                  <Label text="Hasta" />
                  <DatePicker fx:id="dpHasta" prefWidth="130.0" />
                  <Button mnemonicParsing="false" onAction="#filtrar" styleClass="btn-filtrar" text="Filtrar" />
                  <Button mnemonicParsing="false" onAction="#limpiarFiltro" styleClass="btn-limpiar" text="Limpiar filtro" />
               </children>
            </HBox>

            <HBox spacing="10.0" VBox.vgrow="ALWAYS">
               <children>
                  <!-- Formulario -->
                  <VBox prefWidth="330.0" spacing="12.0" styleClass="panel">
                     <children>
                        <Label styleClass="titulo-panel" text="Formulario de Registro" />
                        <GridPane hgap="8.0" vgap="12.0">
                           <columnConstraints>
                              <ColumnConstraints minWidth="110.0" prefWidth="110.0" />
                              <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="180.0" />
                           </columnConstraints>
                           <children>
                              <Label text="Recién nacido" />
                              <TextField fx:id="txtNombreRecienNacido" promptText="Apellidos y nombres" GridPane.columnIndex="1" />
                              <Label text="Fecha nacimiento" GridPane.rowIndex="1" />
                              <DatePicker fx:id="dpFechaNacimiento" maxWidth="1.7976931348623157E308" promptText="dd/mm/aaaa" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                              <Label text="Hospital / Lugar" GridPane.rowIndex="2" />
                              <TextField fx:id="txtHospital" promptText="Lugar de nacimiento" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                              <Label text="Nombre del padre" GridPane.rowIndex="3" />
                              <TextField fx:id="txtNombrePadre" promptText="Apellidos y nombres" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                              <Label text="Nombre de la madre" GridPane.rowIndex="4" />
                              <TextField fx:id="txtNombreMadre" promptText="Apellidos y nombres" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                           </children>
                        </GridPane>
                        <HBox spacing="12.0">
                           <children>
                              <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#validarFormulario" styleClass="btn-guardar" text="Guardar" HBox.hgrow="ALWAYS" />
                              <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#clearForm" styleClass="btn-cancelar" text="Cancelar" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <Label fx:id="lbnMsg" maxWidth="1.7976931348623157E308" wrapText="true" />
                     </children>
                  </VBox>

                  <!-- Tabla -->
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <TableView fx:id="tableView" VBox.vgrow="ALWAYS" />
                        <Label fx:id="lblContador" styleClass="contador" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
